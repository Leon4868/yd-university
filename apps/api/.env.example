NODE_ENV=development
PORT=3001
HOST=127.0.0.1
COURSE_DATA_SOURCE=mock
# Required only when COURSE_DATA_SOURCE=postgres.
DATABASE_URL=postgresql://<USER>:<PASSWORD>@localhost:5432/yd_university
# demo: Authorization: Bearer demo:<privy_user_id>; privy: verify Privy access tokens.
AUTH_MODE=demo
# Required only when AUTH_MODE=privy. Token verification uses the app's public JWKS.
PRIVY_APP_ID=<PRIVY_APP_ID>
# Optional. Only needed for future server-side Privy API calls, not for token verification.
PRIVY_APP_SECRET=<PRIVY_APP_SECRET>
# Comma-separated privy_user_id allowlist promoted to admin on login. Used to bootstrap
# the first administrator after switching to AUTH_MODE=privy.
BOOTSTRAP_ADMIN_SUBJECTS=
# Optional: comma-separated verified wallet addresses promoted to admin.
BOOTSTRAP_ADMIN_WALLETS=
# Optional: verified wallet-to-role mappings, e.g. address=teacher,address=merchant.
WALLET_ROLE_MAPPINGS=
# Backend certificate issuance. Keep off until the three settings below are filled in.
CERTIFICATE_ISSUANCE=off
# Required only when CERTIFICATE_ISSUANCE=on.
SEPOLIA_RPC_URL=<SEPOLIA_RPC_URL>
COURSE_CERTIFICATE_ADDRESS=0x55047EFDd91Ab440CA9eac5bFb91F2C98A25C150
# Dedicated issuing wallet. Grant it MINTER_ROLE only (npm run chain:grant-minter -w @yd/contracts),
# never reuse the admin key, and keep no YD or spare ETH on it.
CERTIFICATE_ISSUER_PRIVATE_KEY=<CERTIFICATE_ISSUER_PRIVATE_KEY>
# Retry sweep interval for failed mints, in milliseconds.
CERTIFICATE_SWEEP_INTERVAL_MS=300000
