{
  "name": "@yd/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint test ignition scripts hardhat.config.ts",
    "deploy:local": "hardhat ignition deploy ignition/modules/YDUniversity.ts",
    "deploy:sepolia": "hardhat ignition deploy --network sepolia --parameters ignition/parameters.sepolia.json ignition/modules/YDUniversity.ts",
    "chain:verify": "hardhat run --network sepolia scripts/verify-deployment.ts",
    "chain:create-course": "hardhat run --network sepolia scripts/create-demo-course.ts",
    "chain:smoke": "hardhat run --network sepolia scripts/smoke-purchase-and-certificate.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^22.20.1",
    "hardhat": "^3.12.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.3",
    "viem": "^2.55.11"
  }
}
