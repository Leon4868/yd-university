# Local PostgreSQL. Replace placeholders in your private .env only.
POSTGRES_DB=yd_university
POSTGRES_USER=yd_local
POSTGRES_PASSWORD=<LOCAL_ONLY_PASSWORD>
DATABASE_URL=postgresql://yd_local:<LOCAL_ONLY_PASSWORD>@localhost:5432/yd_university

# Sepolia deployment. Never commit real values; keep them in your private .env.
SEPOLIA_RPC_URL=<SEPOLIA_RPC_URL>
SEPOLIA_PRIVATE_KEY=<SEPOLIA_DEPLOYER_PRIVATE_KEY>
ETHERSCAN_API_KEY=<ETHERSCAN_API_KEY>
